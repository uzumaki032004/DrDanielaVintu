@page
@model RegisterModel
@{
    ViewData["Title"] = "Înregistrare";
}

<div class="auth-container fade-in">
    <div class="auth-card">
        <div class="text-center mb-5">
            <h2 class="display-6 mb-2">Creează un cont</h2>
            <p class="text-muted">Alătură-te comunității noastre pentru sănătate</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Input.Email" class="form-label small fw-bold text-uppercase ls-1">Email</label>
                <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="nume@exemplu.com" />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label small fw-bold text-uppercase ls-1">Parolă</label>
                <input asp-for="Input.Password" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="minim 6 caractere" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label small fw-bold text-uppercase ls-1">Confirmă Parola</label>
                <input asp-for="Input.ConfirmPassword" class="form-control auth-input" autocomplete="new-password" aria-required="true" placeholder="repetă parola" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-success w-100 py-3 mb-4 shadow-sm">Înregistrare</button>

            <div class="text-center">
                <p class="text-muted small">Ai deja un cont? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-success fw-bold text-decoration-none">Conectează-te</a></p>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
