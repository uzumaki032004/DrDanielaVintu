@{
    ViewData["Title"] = "Laborator 4 - Structural Patterns";
}

<div class="container mt-5">
    <div class="card shadow border-0 mb-4">
        <div class="card-header bg-success text-white">
            <h3>Laborator 4: Adapter, Composite & Façade</h3>
        </div>
        <div class="card-body">
            <!-- Adapter Section -->
            <section class="mb-5">
                <h4 class="text-success border-bottom pb-2">1. Adapter</h4>
                <p class="text-muted">Integrarea unui sistem extern incompatibil.</p>
                <div class="p-3 bg-light border-start border-4 border-success">
                    <h5>@ViewBag.AdapterHeader</h5>
                    <p>@ViewBag.AdapterResults</p>
                </div>
            </section>

            <!-- Composite Section -->
            <section class="mb-5">
                <h4 class="text-success border-bottom pb-2">2. Composite</h4>
                <p class="text-muted">Tratarea uniformă a structurilor ierarhice (Rapoarte).</p>
                <pre class="bg-dark text-light p-3 rounded">@ViewBag.CompositeReport</pre>
            </section>

            <!-- Facade Section -->
            <section>
                <h4 class="text-success border-bottom pb-2">3. Façade</h4>
                <p class="text-muted">Interfață simplificată către un subsistem complex (Onboarding).</p>
                <div class="alert alert-info">
                    @Html.Raw(ViewBag.OnboardingResult.Replace("\n", "<br/>"))
                </div>
            </section>
        </div>
        <div class="card-footer text-end">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
            <a asp-controller="Lab3" asp-action="Index" class="btn btn-outline-info">Laborator 3</a>
        </div>
    </div>
</div>
