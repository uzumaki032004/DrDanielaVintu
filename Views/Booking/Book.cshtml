@model DrDanielaVintu.Models.Booking
@{
    ViewData["Title"] = "Rezervă Program";
}

<div class="container py-5 mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-lg" style="border-radius: 40px; overflow: hidden;">
                <div class="row g-0">
                    <div class="col-md-5 bg-success p-5 text-white d-flex flex-column justify-content-center">
                        <h6 class="text-uppercase ls-1 opacity-75 mb-3 fw-bold">Ai ales programul:</h6>
                        <h2 class="display-6 fw-bold mb-4">@Model.Plan?.Name</h2>
                        <div class="h1 fw-bold mb-4">@Model.Plan?.Price.ToString("F0") <small class="fs-6 opacity-75">EUR</small></div>
                        <ul class="list-unstyled opacity-75 small">
                            <li class="mb-2"><i class="fas fa-check-circle me-2"></i> Ghidare personalizată</li>
                            <li class="mb-2"><i class="fas fa-check-circle me-2"></i> Suport dedicat</li>
                            <li class="mb-2"><i class="fas fa-check-circle me-2"></i> Rezultate durabile</li>
                        </ul>
                    </div>
                    <div class="col-md-7 p-5 bg-white">
                        <h3 class="fw-bold mb-4">Finalizează Rezervarea</h3>
                        
                        <form asp-action="Book" method="post">
                            <input type="hidden" asp-for="PlanId" />
                            
                            <div class="mb-4">
                                <label asp-for="ClientName" class="form-label fw-bold">Nume Complet</label>
                                <input asp-for="ClientName" class="form-control rounded-pill px-4" placeholder="Ion Popescu" />
                                <span asp-validation-for="ClientName" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label asp-for="ClientEmail" class="form-label fw-bold">Email</label>
                                    <input asp-for="ClientEmail" class="form-control rounded-pill px-4" placeholder="nume@email.com" />
                                    <span asp-validation-for="ClientEmail" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 mb-4">
                                    <label asp-for="ClientPhone" class="form-label fw-bold">Telefon</label>
                                    <input asp-for="ClientPhone" class="form-control rounded-pill px-4" placeholder="07xx xxx xxx" />
                                    <span asp-validation-for="ClientPhone" class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="PreferredDate" class="form-label fw-bold">Când dorești prima consultație?</label>
                                <input asp-for="PreferredDate" type="date" class="form-control rounded-pill px-4" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="PreferredDate" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Message" class="form-label fw-bold">Observații (opțional)</label>
                                <textarea asp-for="Message" class="form-control" rows="3" style="border-radius: 20px;" placeholder="Dacă ai întrebări sau preferințe specifice..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-success w-100 rounded-pill py-3 fw-bold shadow-lg mt-3">
                                Trimite Solicitarea <i class="fas fa-calendar-check ms-2"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            <div class="text-center mt-4">
                <a asp-action="Subscriptions" asp-controller="Home" class="text-muted text-decoration-none small">
                    <i class="fas fa-arrow-left me-2"></i> Înapoi la lista de programe
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
