<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dr. Daniela Vîntu</title>
    
    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DrDanielaVintu.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand">
            <div class="container d-flex justify-content-between align-items-center">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <span class="logo-text">dr. Daniela Vîntu</span>
                </a>
                <div class="d-flex align-items-center gap-3">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-success btn-sm px-3 py-2"><i class="fas fa-tools me-1"></i>Admin</a>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="footer text-muted mt-5">
        <div class="container text-center">
            <h5 class="logo-text mb-4">dr. Daniela Vîntu</h5>
            <div class="mb-4 d-flex justify-content-center gap-4">
                <a asp-action="About" class="text-decoration-none text-muted">Despre mine</a>
                <a asp-action="Subscriptions" class="text-decoration-none text-muted">Programe</a>
                <a asp-action="Contact" class="text-decoration-none text-muted">Contact</a>
            </div>
            <p class="small opacity-50">&copy; 2026 - Toate drepturile rezervate. <a asp-action="Privacy" class="text-muted">Confidențialitate</a></p>
        </div>
    </footer>

    <nav class="bottom-nav">
        <a class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">
            <i class="fas fa-home"></i><span>Acasă</span>
        </a>
        <a class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">
            <i class="fas fa-user-md"></i><span>Despre</span>
        </a>
        <a class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Subscriptions" ? "active" : "")" asp-controller="Home" asp-action="Subscriptions">
            <i class="fas fa-calendar-check"></i><span>Programe</span>
        </a>
        <a class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "News" ? "active" : "")" asp-controller="Home" asp-action="News">
            <i class="fas fa-bullhorn"></i><span>Noutăți</span>
        </a>
        <a class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Articles" ? "active" : "")" asp-controller="Home" asp-action="Articles">
            <i class="fas fa-feather-pointed"></i><span>Articole</span>
        </a>
        <a class="bottom-nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">
            <i class="fas fa-envelope"></i><span>Contact</span>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
