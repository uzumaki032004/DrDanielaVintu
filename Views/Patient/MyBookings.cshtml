@model List<DrDanielaVintu.Models.Booking>
@{
    ViewData["Title"] = "Rezervările Mele";
}

<div class="container py-5 mt-5">
    <div class="d-flex justify-content-between align-items-center mb-5">
        <h2 class="fw-bold" style="color: var(--royal-green);">Rezervările Mele</h2>
        <a asp-action="Dashboard" class="btn btn-outline-success rounded-pill px-4">
            <i class="fas fa-arrow-left me-2"></i> Înapoi la Dashboard
        </a>
    </div>

    <div class="bg-white p-4 rounded-4 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Program</th>
                        <th>Data Rezervării</th>
                        <th>Data Preferată</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td class="fw-bold">@b.Plan?.Name</td>
                            <td class="text-muted">@b.CreatedAt.ToString("dd.MM.yyyy")</td>
                            <td>@b.PreferredDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                @if (b.Status == "Pending") { <span class="badge bg-warning text-dark rounded-pill px-3">În așteptare</span> }
                                else if (b.Status == "Confirmed") { <span class="badge bg-success rounded-pill px-3">Confirmat</span> }
                                else { <span class="badge bg-danger rounded-pill px-3">Anulat</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <p class="text-muted">Nu ai efectuat nicio rezervare până acum.</p>
                <a asp-controller="Home" asp-action="Subscriptions" class="btn btn-success rounded-pill px-4">Vezi Programele</a>
            </div>
        }
    </div>
</div>
