@model List<DrDanielaVintu.Models.Booking>
@{
    ViewData["Title"] = "Tablou de Bord Pacient";
    var latestArticles = ViewBag.LatestArticles as List<DrDanielaVintu.Models.Article>;
}

<div class="container py-5 mt-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="bg-white p-5 rounded-4 shadow-sm mb-4">
                <h2 class="fw-bold mb-4" style="color: var(--royal-green);">Bună ziua, @User.Identity?.Name!</h2>
                <p class="text-secondary mb-0">Bine ai revenit în spațiul tău personal. Aici poți vedea starea rezervărilor tale și ultimele noutăți.</p>
            </div>

            <h4 class="fw-bold mb-4">Rezervările Tale</h4>
            @if (Model.Any())
            {
                <div class="row g-3">
                    @foreach (var b in Model)
                    {
                        <div class="col-12">
                            <div class="card border-0 shadow-sm rounded-4">
                                <div class="card-body p-4 d-flex justify-content-between align-items-center">
                                    <div>
                                        <h6 class="fw-bold mb-1">@b.Plan?.Name</h6>
                                        <small class="text-muted">Data preferată: @b.PreferredDate.ToString("dd.MM.yyyy")</small>
                                    </div>
                                    <div>
                                        @if (b.Status == "Pending") { <span class="badge bg-warning text-dark rounded-pill">În așteptare</span> }
                                        else if (b.Status == "Confirmed") { <span class="badge bg-success rounded-pill">Confirmat</span> }
                                        else { <span class="badge bg-danger rounded-pill">Anulat</span> }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="bg-light p-5 rounded-4 text-center">
                    <i class="fas fa-calendar-plus fa-3x text-muted mb-3 opacity-25"></i>
                    <p class="text-muted">Nu ai nicio rezervare activă momentan.</p>
                    <a asp-controller="Home" asp-action="Subscriptions" class="btn btn-success rounded-pill px-4">Alege un program</a>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-success text-white">
                <h5 class="fw-bold mb-3">Acces Rapid</h5>
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><a asp-action="MyBookings" class="text-white text-decoration-none"><i class="fas fa-history me-2"></i> Istoric Rezervări</a></li>
                    <li class="mb-2"><a asp-area="Identity" asp-page="/Account/Manage/Index" class="text-white text-decoration-none"><i class="fas fa-user-cog me-2"></i> Setări Profil</a></li>
                    <li><a asp-controller="Home" asp-action="Calculator" class="text-white text-decoration-none"><i class="fas fa-calculator me-2"></i> Calculator IMC</a></li>
                </ul>
            </div>

            <h5 class="fw-bold mb-4">Articole Recente</h5>
            @if (latestArticles != null)
            {
                foreach (var art in latestArticles)
                {
                    <div class="card border-0 shadow-sm rounded-4 mb-3 overflow-hidden">
                        <div class="card-body p-3">
                            <h6 class="fw-bold mb-1 small">@art.Title</h6>
                            <a asp-controller="Home" asp-action="ArticleDetails" asp-route-id="@art.Id" class="btn btn-link p-0 text-success text-decoration-none x-small">Citește <i class="fas fa-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
