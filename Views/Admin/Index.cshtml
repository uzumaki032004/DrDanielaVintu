@{
    ViewData["Title"] = "Dashboard Admin";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2">🛠️ Admin Dashboard</h1>
    <div class="text-muted">@DateTime.Now.ToLongDateString()</div>
</div>

<div class="row g-4">
    <!-- Row 1 -->
    <div class="col-md-4">
        <div class="card h-100 text-center p-4 shadow-sm border-0 transition-hover">
            <div class="display-5 text-primary mb-3"><i class="fas fa-home"></i></div>
            <h4>Pagina Acasă</h4>
            <p class="text-muted small">Editează textul principal, subtitlul și butonul CTA.</p>
            <a asp-action="EditHome" class="btn btn-outline-primary mt-auto">Editează</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4 shadow-sm border-0 transition-hover">
            <div class="display-5 text-success mb-3"><i class="fas fa-user-md"></i></div>
            <h4>Despre Mine</h4>
            <p class="text-muted small">Actualizează biografia, titlul profesional și fotografia.</p>
            <a asp-action="EditAbout" class="btn btn-outline-success mt-auto">Editează</a>
        </div>
    </div>

    <!-- Row 2 -->
    <div class="col-md-4">
        <div class="card h-100 text-center p-4 shadow-sm border-0 transition-hover">
            <div class="display-5 text-info mb-3"><i class="fas fa-gem"></i></div>
            <h4>Programe</h4>
            <p class="text-muted small">Gestionează prețurile și beneficiile pentru planurile de abonament.</p>
            <a asp-action="EditPrograms" class="btn btn-outline-info mt-auto">Editează</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4 shadow-sm border-0 transition-hover">
            <div class="display-5 text-danger mb-3"><i class="fas fa-bell"></i></div>
            <h4>Noutăți</h4>
            <p class="text-muted small">Publică anunțuri și evenimente noi pentru pacienți.</p>
            <a asp-action="EditNews" class="btn btn-outline-danger mt-auto">Editează</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4 shadow-sm border-0 transition-hover">
            <div class="display-5 text-dark mb-3"><i class="fas fa-book-open"></i></div>
            <h4>Articole</h4>
            <p class="text-muted small">Scrie și gestionează articolele de blog și educație nutrițională.</p>
            <a asp-action="EditArticles" class="btn btn-outline-dark mt-auto">Editează</a>
        </div>
    </div>
</div>

<div class="mt-4">
    <div class="card p-4 border-0 shadow-sm">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-1"><i class="fas fa-envelope me-2 text-primary"></i>Contact</h4>
                <p class="mb-0 text-muted small">Actualizează datele de contact și rețelele sociale.</p>
            </div>
            <a asp-action="EditContact" class="btn btn-primary">Editează Contact</a>
        </div>
    </div>
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
