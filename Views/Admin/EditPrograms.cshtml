@model List<DrDanielaVintu.Models.SubscriptionPlan>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestiune Programe și Consultații";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-success"><i class="fas fa-calendar-alt me-2"></i>Gestiune Programe</h2>
    <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addProgramModal">
        <i class="fas fa-plus me-2"></i>Adaugă Program Nou
    </button>
</div>

<div class="row g-4">
    @foreach (var plan in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 position-relative">
                @if (plan.IsPopular)
                {
                    <span class="badge bg-warning text-dark position-absolute top-0 start-50 translate-middle rounded-pill px-3 shadow-sm">Popular</span>
                }
                <div class="card-body p-4 d-flex flex-column">
                    <h4 class="fw-bold mb-3">@plan.Name</h4>
                    <h2 class="text-success mb-4">@plan.Price EUR</h2>
                    
                    <ul class="list-unstyled mb-4 small flex-grow-1">
                        @{
                            var benefits = plan.Benefits.Split(new[] { ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries);
                            foreach (var benefit in benefits)
                            {
                                <li class="mb-2"><i class="fas fa-check text-success me-2"></i>@benefit.Trim()</li>
                            }
                        }
                    </ul>

                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-outline-primary btn-sm flex-grow-1 rounded-pill" 
                                data-bs-toggle="modal" 
                                data-bs-target="#editModal-@plan.Id">
                            <i class="fas fa-edit me-1"></i>Edit
                        </button>
                        <a asp-action="DeleteProgram" asp-route-id="@plan.Id" 
                           class="btn btn-outline-danger btn-sm rounded-pill"
                           onclick="return confirm('Ești sigur că vrei să ștergi acest program?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Edit Modal -->
        <div class="modal fade" id="editModal-@plan.Id" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content border-0 shadow">
                    <form asp-action="UpdateProgram" method="post">
                        <div class="modal-header bg-success text-white border-0">
                            <h5 class="modal-title">Editează Program: @plan.Name</h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body p-4">
                            <input type="hidden" name="Id" value="@plan.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-bold">Denumire Program</label>
                                <input type="text" name="Name" value="@plan.Name" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Preț (EUR)</label>
                                <input type="number" name="Price" value="@plan.Price" class="form-control" required />
                            </div>
                            <div class="mb-3">
                                <label class="form-label fw-bold">Beneficii (apasă 'Enter' pentru fiecare beneficiu nou)</label>
                                <textarea name="Benefits" class="form-control" rows="8" required>@plan.Benefits</textarea>
                            </div>
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" name="IsPopular" value="true" @(plan.IsPopular ? "checked" : "") />
                                <label class="form-check-label">Marchează ca "Cel mai popular"</label>
                            </div>
                        </div>
                        <div class="modal-footer border-0">
                            <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Anulează</button>
                            <button type="submit" class="btn btn-success rounded-pill px-4">Salvează Modificările</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Modal -->
<div class="modal fade" id="addProgramModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddProgram" method="post">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title">Adaugă Program Nou</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Denumire Program</label>
                        <input type="text" name="Name" class="form-control" placeholder="Ex: Pachet VIP" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Preț (EUR)</label>
                        <input type="number" name="Price" class="form-control" placeholder="Ex: 800" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Beneficii (un beneficiu pe rând)</label>
                        <textarea name="Benefits" class="form-control" rows="8" placeholder="Beneficiu 1&#10;Beneficiu 2&#10;Beneficiu 3" required></textarea>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" name="IsPopular" value="true" />
                        <label class="form-check-label">Marchează ca "Cel mai popular"</label>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Anulează</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Adaugă Program</button>
                </div>
            </form>
        </div>
    </div>
</div>
