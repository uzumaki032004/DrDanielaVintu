@model List<DrDanielaVintu.Models.Testimonial>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Testimoniale";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-success"><i class="fas fa-quote-left me-2"></i>Gestiune Testimoniale</h2>
    <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addModal">
        <i class="fas fa-plus me-1"></i> Adaugă Testimonial
    </button>
</div>

<div class="row g-4">
    @foreach (var t in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex gap-1">
                            @for (int i = 0; i < t.Rating; i++)
                            {
                                <i class="fas fa-star text-warning small"></i>
                            }
                        </div>
                        <span class="badge @(t.IsVisible ? "bg-success" : "bg-secondary") rounded-pill">@(t.IsVisible ? "Vizibil" : "Ascuns")</span>
                    </div>
                    <p class="card-text text-secondary mb-4 italic">"@t.Text"</p>
                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-0">@t.ClientName</h6>
                        </div>
                        <div class="d-flex gap-2">
                            <form asp-action="ToggleTestimonialVisibility" asp-route-id="@t.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">
                                    <i class="fas @(t.IsVisible ? "fa-eye-slash" : "fa-eye")"></i>
                                </button>
                            </form>
                            <a asp-action="DeleteTestimonial" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Ștergi testimonialul?')">
                                <i class="fas fa-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Modal -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 rounded-4">
            <form asp-action="AddTestimonial" method="post">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold">Adaugă Testimonial Nou</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nume Client</label>
                        <input name="ClientName" class="form-control rounded-pill px-4" required placeholder="Ex: Maria Popescu" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Inițiale (opțional)</label>
                        <input name="ClientInitials" class="form-control rounded-pill px-4" placeholder="Ex: MP" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Rating (1-5)</label>
                        <select name="Rating" class="form-select rounded-pill px-4">
                            <option value="5" selected>5 Stele</option>
                            <option value="4">4 Stele</option>
                            <option value="3">3 Stele</option>
                            <option value="2">2 Stele</option>
                            <option value="1">1 Stea</option>
                        </select>
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-bold">Mesaj</label>
                        <textarea name="Text" class="form-control" rows="4" style="border-radius: 20px;" required placeholder="Ce a spus clientul..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="submit" class="btn btn-success rounded-pill px-4 py-2 w-100 fw-bold shadow-lg">Salvează Testimonialul</button>
                </div>
            </form>
        </div>
    </div>
</div>
