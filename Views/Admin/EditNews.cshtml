@model List<DrDanielaVintu.Models.NewsItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestiune Noutăți";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-success"><i class="fas fa-bullhorn me-2"></i>Noutăți și Anunțuri</h2>
    <button class="btn btn-success rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addNewsModal">
        <i class="fas fa-plus me-2"></i>Adaugă Anunț
    </button>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h4 class="fw-bold mb-0">@item.Title</h4>
                        <a asp-action="DeleteNews" asp-route-id="@item.Id" class="text-danger" onclick="return confirm('Ștergi acest anunț?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </div>
                    <p class="text-secondary mb-3">@item.Description</p>
                    <div class="small">
                        @if (item.EventDate.HasValue)
                        {
                            <span class="badge bg-light text-success"><i class="fas fa-calendar-event me-1"></i> @item.EventDate.Value.ToString("dd.MM.yyyy")</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-primary"><i class="fas fa-thumbtack me-1"></i> Anunț Permanent</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- Add Modal -->
<div class="modal fade" id="addNewsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="AddNews" method="post">
                <div class="modal-header bg-success text-white border-0">
                    <h5 class="modal-title">Adaugă Anunț Nou</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Titlu Anunț</label>
                        <input type="text" name="Title" class="form-control" placeholder="Ex: Webinar nou" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descriere</label>
                        <textarea name="Description" class="form-control" rows="4" placeholder="Detalii despre anunț..." required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Data Evenimentului (opțional)</label>
                        <input type="date" name="EventDate" class="form-control" />
                        <small class="text-muted">Lasă gol pentru un anunț permanent (fără dată).</small>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Anulează</button>
                    <button type="submit" class="btn btn-success rounded-pill px-4">Adaugă Anunț</button>
                </div>
            </form>
        </div>
    </div>
</div>
