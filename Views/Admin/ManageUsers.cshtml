@using Microsoft.AspNetCore.Identity
@model List<IdentityUser>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Gestiune Utilizatori";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>>;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-success"><i class="fas fa-users me-2"></i>Utilizatori Înregistrați</h2>
</div>

<div class="bg-white p-4 rounded-4 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Email / Username</th>
                    <th>Roluri</th>
                    <th>Status Email</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="fw-bold">@user.Email</td>
                        <td>
                            @if (userRoles != null && userRoles.ContainsKey(user.Id))
                            {
                                foreach (var role in userRoles[user.Id])
                                {
                                    <span class="badge bg-light text-success border border-success rounded-pill me-1">@role</span>
                                }
                            }
                        </td>
                        <td>
                            @if (user.EmailConfirmed)
                            {
                                <span class="text-success small"><i class="fas fa-check-circle me-1"></i> Confirmat</span>
                            }
                            else
                            {
                                <span class="text-warning small"><i class="fas fa-clock me-1"></i> Neconfirmat</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
