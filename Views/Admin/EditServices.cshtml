@model List<DrDanielaVintu.Models.Service>
@{
    ViewData["Title"] = "Gestionare Servicii";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>💼 Gestionare Servicii</h2>
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addServiceModal">Adaugă Serviciu Nou</button>
</div>

<div class="row g-4">
    @foreach (var service in Model)
    {
        <div class="col-md-4">
            <div class="card p-3 shadow-sm border-0">
                <div class="d-flex align-items-center mb-2">
                    <i class="@service.IconName fs-3 text-primary me-3"></i>
                    <h5 class="mb-0">@service.Name</h5>
                </div>
                <p class="small text-muted mb-3">@service.Description</p>
                <div class="d-flex justify-content-between align-items-center mt-auto">
                    <span class="fw-bold">@service.Price RON</span>
                    <a asp-action="DeleteService" asp-route-id="@service.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Sigur vrei să ștergi acest serviciu?')">Șterge</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal Adăugare -->
<div class="modal fade" id="addServiceModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddService" method="post" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Adaugă Serviciu Nou</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Nume Serviciu</label>
                    <input type="text" name="Name" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label">Descriere Scurtă</label>
                    <textarea name="Description" class="form-control" rows="3" required></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Preț (RON)</label>
                        <input type="number" name="Price" class="form-control" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Icon (FontAwesome)</label>
                        <input type="text" name="IconName" class="form-control" value="fas fa-heartbeat">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Închide</button>
                <button type="submit" class="btn btn-primary">Salvează Serviciul</button>
            </div>
        </form>
    </div>
</div>
