@model List<DrDanielaVintu.Models.ContactMessage>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Mesaje Contact";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-success"><i class="fas fa-envelope-open-text me-2"></i>Mesaje Primite</h2>
    <div class="badge bg-success rounded-pill px-3 py-2">
        @Model.Count(m => !m.IsRead) Mesaje Noi
    </div>
</div>

<div class="row g-4">
    @foreach (var msg in Model)
    {
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4 @(msg.IsRead ? "opacity-75" : "border-start border-success border-4")">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="fw-bold mb-1">@msg.Subject</h5>
                            <p class="text-muted small mb-0">
                                <i class="fas fa-user me-1"></i> @msg.Name | 
                                <i class="fas fa-envelope me-1"></i> @msg.Email | 
                                <i class="fas fa-phone me-1"></i> @(msg.Phone ?? "Nespecificat")
                            </p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-light text-dark rounded-pill mb-2">@msg.SentAt.ToString("dd.MM.yyyy HH:mm")</span>
                            <div class="d-flex gap-2 justify-content-end">
                                @if (!msg.IsRead)
                                {
                                    <form asp-action="MarkAsRead" asp-route-id="@msg.Id" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-success rounded-pill">
                                            <i class="fas fa-check"></i> Marcare Citit
                                        </button>
                                    </form>
                                }
                                <a asp-action="DeleteMessage" asp-route-id="@msg.Id" class="btn btn-sm btn-outline-danger rounded-pill" onclick="return confirm('Ștergi acest mesaj?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <hr class="opacity-10">
                    <p class="card-text text-dark" style="white-space: pre-line;">@msg.Message</p>
                </div>
            </div>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="fas fa-inbox fa-4x text-muted mb-3 opacity-25"></i>
        <h4 class="text-muted">Nu există mesaje în inbox.</h4>
    </div>
}
