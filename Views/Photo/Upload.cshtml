@{
    ViewData["Title"] = "Upload Foto";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4">
                <h2 class="text-center mb-4" style="color: var(--royal-green);">Încarcă o Imagine pe Cloudinary</h2>
                
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                @if (ViewBag.ImageUrl != null)
                {
                    <div class="alert alert-success">Imagine încărcată cu succes!</div>
                    <div class="text-center mb-4">
                        <img src="@ViewBag.ImageUrl" class="img-fluid rounded shadow-sm" alt="Uploaded Image" style="max-height: 300px;" />
                        <p class="mt-2 small text-muted">Public ID: @ViewBag.PublicId</p>
                        <p class="small"><a href="@ViewBag.ImageUrl" target="_blank">Vezi imaginea completă</a></p>
                    </div>
                }

                <form asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="file" class="form-label">Selectează fișierul</label>
                        <input type="file" name="file" class="form-control" id="file" accept="image/*" required>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 py-2">Încarcă Imaginea</button>
                </form>
            </div>
        </div>
    </div>
</div>
