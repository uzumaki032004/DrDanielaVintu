@model List<DrDanielaVintu.Models.NewsItem>
@{
    ViewData["Title"] = "Noutăți și Anunțuri";
}

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h6 class="text-success text-uppercase fw-bold ls-1 mb-2">Rămâi la curent</h6>
        <h1 class="display-4 fw-bold mb-3" style="color: var(--royal-green);">Noutăți și Anunțuri</h1>
        <p class="lead text-secondary mx-auto" style="max-width: 600px;">
            Aici găsești ultimele noutăți despre seminarii, cursuri și evenimente speciale.
        </p>
    </div>

    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-lg-10 mx-auto">
                <div class="card border-0 shadow-sm p-4 news-card" style="border-radius: 20px; border-left: 5px solid var(--royal-green) !important;">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                @if (item.EventDate.HasValue)
                                {
                                    <span class="badge bg-light text-success"><i class="fas fa-calendar-alt me-1"></i> @item.EventDate.Value.ToString("dd MMMM yyyy")</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-primary"><i class="fas fa-thumbtack me-1"></i> Anunț Permanent</span>
                                }
                                
                                @if (item.IsPremiumOnly)
                                {
                                    <span class="badge bg-warning text-dark">Premium</span>
                                }
                            </div>
                            <h3 class="fw-bold mb-2" style="color: var(--royal-green);">@item.Title</h3>
                            <p class="text-secondary mb-0 fs-5">@item.Description</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-bullhorn fa-4x text-light mb-3"></i>
                <p class="text-muted">Nu există anunțuri în acest moment.</p>
            </div>
        }
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 2px; }
    .news-card {
        transition: transform 0.3s ease;
    }
    .news-card:hover {
        transform: scale(1.02);
    }
</style>
