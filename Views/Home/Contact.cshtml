@model Dictionary<string, string>
@{ ViewData["Title"] = "Contact"; var phone = Model.GetValueOrDefault("Contact_Phone", ""); var email = Model.GetValueOrDefault("Contact_Email", ""); var address = Model.GetValueOrDefault("Contact_Address", ""); var fb = Model.GetValueOrDefault("Contact_Facebook", ""); var ig = Model.GetValueOrDefault("Contact_Instagram", ""); }
<div class="container py-5"><div class="row"><div class="col-md-6"><h1 class="mb-4">Contacteaza-ne</h1><div class="mb-4"><h5><i class="fas fa-phone me-3"></i>Telefon</h5><p class="lead">@phone</p></div><div class="mb-4"><h5><i class="fas fa-envelope me-3"></i>Email</h5><p class="lead">@email</p></div><div class="mb-4"><h5><i class="fas fa-map-marker-alt me-3"></i>Adresa</h5><p class="lead">@address</p></div><div class="d-flex gap-3 mt-5"><a href='@fb' class="btn btn-outline-primary rounded-circle"><i class="fab fa-facebook-f"></i></a><a href='@ig' class="btn btn-outline-danger rounded-circle"><i class="fab fa-instagram"></i></a></div></div><div class="col-md-6"><div class="card p-4 border-0 shadow-sm"><form><h3>Trimite-ne un mesaj</h3><div class="mb-3"><label class="form-label">Nume</label><input type="text" class="form-control"></div><div class="mb-3"><label class="form-label">Email</label><input type="email" class="form-control"></div><div class="mb-3"><label class="form-label">Mesaj</label><textarea class="form-control" rows="5"></textarea></div><button type="submit" class="btn btn-primary w-100 py-2">Trimite Mesaj</button></form></div></div></div></div>
