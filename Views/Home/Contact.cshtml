@model Dictionary<string, string>
@{
    ViewData["Title"] = "Contact";
    var phone = Model.GetValueOrDefault("Contact_Phone", "+373 60 000 000");
    var email = Model.GetValueOrDefault("Contact_Email", "contact@drdanielavintu.com");
    var address = Model.GetValueOrDefault("Contact_Address", "Chisinau, Moldova");
    var fb = Model.GetValueOrDefault("Contact_Facebook", "#");
    var ig = Model.GetValueOrDefault("Contact_Instagram", "#");
    var contactMessage = new DrDanielaVintu.Models.ContactMessage();
}

<div class="container py-5 mt-5">
    <div class="row g-5">
        <div class="col-lg-5">
            <h6 class="text-success text-uppercase fw-bold ls-1 mb-3">Să discutăm</h6>
            <h1 class="display-4 fw-bold mb-5" style="color: var(--royal-green);">Contactează-ne</h1>
            
            <div class="d-flex mb-4">
                <div class="bg-light rounded-circle p-3 me-4 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-phone text-success fs-4"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Telefon</h5>
                    <p class="text-secondary">@phone</p>
                </div>
            </div>

            <div class="d-flex mb-4">
                <div class="bg-light rounded-circle p-3 me-4 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-envelope text-success fs-4"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Email</h5>
                    <p class="text-secondary">@email</p>
                </div>
            </div>

            <div class="d-flex mb-4">
                <div class="bg-light rounded-circle p-3 me-4 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                    <i class="fas fa-map-marker-alt text-success fs-4"></i>
                </div>
                <div>
                    <h5 class="fw-bold mb-1">Locație</h5>
                    <p class="text-secondary">@address</p>
                </div>
            </div>

            <div class="d-flex gap-3 mt-5">
                <a href="@fb" class="btn btn-outline-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="@ig" class="btn btn-outline-success rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fab fa-instagram"></i>
                </a>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card p-5 border-0 shadow-lg" style="border-radius: 40px;">
                <h3 class="fw-bold mb-4">Trimite-ne un mesaj</h3>

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success rounded-4 border-0 mb-4">
                        <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
                    </div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger rounded-4 border-0 mb-4">
                        <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
                    </div>
                }

                <form asp-controller="Contact" asp-action="SendMessage" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Nume Complet</label>
                            <input name="Name" class="form-control rounded-pill px-4 py-2" placeholder="Ex: Ion Popescu" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input name="Email" type="email" class="form-control rounded-pill px-4 py-2" placeholder="nume@exemplu.com" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Telefon (opțional)</label>
                            <input name="Phone" class="form-control rounded-pill px-4 py-2" placeholder="07xx xxx xxx" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Subiect</label>
                            <select name="Subject" class="form-select rounded-pill px-4 py-2" required>
                                <option value="" disabled selected>Alege un subiect</option>
                                <option value="Consultație">Consultație</option>
                                <option value="Program Nutriție">Program Nutriție</option>
                                <option value="Întrebare Generală">Întrebare Generală</option>
                                <option value="Colaborare">Colaborare</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Mesajul tău</label>
                        <textarea name="Message" class="form-control" rows="5" style="border-radius: 20px; padding: 20px;" placeholder="Scrie mesajul tău aici..." required></textarea>
                    </div>

                    <button type="submit" class="btn btn-success w-100 rounded-pill py-3 fw-bold shadow-lg">
                        Trimite Mesajul <i class="fas fa-paper-plane ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
