@model Dictionary<string, string>
@{
    ViewData["Title"] = "Acasă";
    var heroTitle = Model.GetValueOrDefault("Home_HeroTitle", "Construiește un stil de viață sănătos care durează");
    var heroSub = Model.GetValueOrDefault("Home_HeroSubtitle", "Ghidare personalizată pentru energie, echilibru și stare de bine pe termen lung.");
    var heroCta = Model.GetValueOrDefault("Home_HeroCta", "Programează o consultație");

    var aboutBio = Model.GetValueOrDefault("About_Bio", "Misiunea mea este să îți ofer claritate...");
    var aboutPhoto = Model.GetValueOrDefault("About_PhotoUrl", "");
    var programs = ViewBag.Programs as List<DrDanielaVintu.Models.SubscriptionPlan>;
    var latestArticles = ViewBag.LatestArticles as List<DrDanielaVintu.Models.Article>;
}

<!-- Hero Section -->
<section class="section-padding text-center fade-in">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <h6 class="text-uppercase ls-1 text-muted mb-4 small fw-bold">Nutriție & Dietetică Personalizată</h6>
                <h1 class="display-1 mb-5" style="line-height: 1.1;">@heroTitle</h1>
                <p class="lead mb-5 mx-auto opacity-75" style="max-width: 750px; font-size: 1.25rem;">@heroSub</p>
                <div class="d-flex flex-column flex-md-row gap-4 justify-content-center">
                    <a asp-action="Contact" class="btn btn-success px-5 py-3 shadow-lg">@heroCta</a>
                    <a href="#programe" class="btn btn-outline-success px-5 py-3">Descoperă Programele</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="section-padding bg-white" id="despre">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="position-relative">
                    @if (!string.IsNullOrEmpty(aboutPhoto))
                    {
                        <img src="@aboutPhoto" class="img-fluid rounded-4 shadow-2xl" alt="Dr. Daniela Vîntu" style="border-radius: 40px !important;">
                    }
                    else
                    {
                        <div class="bg-light p-5 rounded-4 text-center" style="height: 500px; display: flex; align-items: center; justify-content: center; border-radius: 40px !important;">
                            <i class="fas fa-user-md fa-10x opacity-10"></i>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6 ps-lg-5">
                <h6 class="text-uppercase ls-1 text-muted mb-3 small fw-bold">Despre mine</h6>
                <h2 class="display-4 mb-4">Abordare bazată pe știință și empatie</h2>
                <div class="text-secondary mb-5 fs-5 lh-lg" style="white-space: pre-line;">
                    @(aboutBio.Length > 600 ? aboutBio.Substring(0, 600) + "..." : aboutBio)
                </div>
                <a asp-action="About" class="btn btn-outline-success px-5">Povestea Mea Completă</a>
            </div>
        </div>
    </div>
</section>

<!-- Programs Section -->
<section class="section-padding" id="programe">
    <div class="container text-center">
        <h6 class="text-uppercase ls-1 text-muted mb-3 small fw-bold">Investiție în tine</h6>
        <h2 class="display-3 mb-5">Programe de Nutriție</h2>
        
        <div class="row g-4 mt-4 program-row">
            @if (programs != null)
            {
                @foreach (var plan in programs.Take(3))
                {
                    <div class="col-lg-4 program-col">
                        <div class="card h-100 p-5 text-center border-0 shadow-sm" style="border-radius: 40px;">
                            @if (plan.IsPopular)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2 text-uppercase mb-4 align-self-center small ls-1">Cel mai ales</span>
                            }
                            <h3 class="mb-3">@plan.Name</h3>
                            <div class="mb-4">
                                <span class="h1 fw-bold text-success">@plan.Price.ToString("F0")</span>
                                <span class="text-muted">EUR</span>
                            </div>
                            <ul class="list-unstyled mb-5 text-start opacity-75">
                                @foreach (var b in plan.Benefits.Split(new[] { ';', '\n' }, StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li class="mb-3 d-flex align-items-start gap-2">
                                        <i class="fas fa-check text-success mt-1 small"></i>
                                        <span>@b.Trim()</span>
                                    </li>
                                }
                            </ul>
                            <a asp-action="Subscriptions" class="btn btn-success w-100 mt-auto py-3">Detalii Program</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Testimonials Section -->
<section class="section-padding bg-light">
    <div class="container">
        <div class="text-center mb-5">
            <h6 class="text-uppercase ls-1 text-muted mb-3 small fw-bold">Succesul pacienților</h6>
            <h2 class="display-3 mb-5">Gânduri de la clienți</h2>
        </div>

        <div class="row g-4 mt-4 testimonial-row">
            @{
                var testimonials = ViewBag.Testimonials as List<DrDanielaVintu.Models.Testimonial>;
            }
            @if (testimonials != null && testimonials.Any())
            {
                @foreach (var t in testimonials)
                {
                    <div class="col-lg-4 testimonial-col">
                        <div class="card h-100 p-5 border-0 shadow-sm" style="border-radius: 40px;">
                            <div class="mb-4">
                                @for (int i = 0; i < t.Rating; i++)
                                {
                                    <i class="fas fa-star text-warning small"></i>
                                }
                            </div>
                            <p class="fs-5 text-secondary mb-5 lh-base italic">"@t.Text"</p>
                            <div class="mt-auto d-flex align-items-center gap-3">
                                <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 50px; height: 50px; font-size: 0.9rem;">
                                    @t.ClientInitials
                                </div>
                                <div class="text-start">
                                    <h6 class="fw-bold mb-0">@t.ClientName</h6>
                                    <small class="text-muted">Pacient @(t.CreatedAt.Year)</small>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center col-12 py-5 opacity-25">
                    <p>Urmează să fie adăugate testimoniale.</p>
                </div>
            }
        </div>
    </div>
</section>

<!-- Articles Section -->
<section class="section-padding bg-white">
    <div class="container">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-5 text-center text-md-start">
            <div>
                <h6 class="text-uppercase ls-1 text-muted mb-2 small fw-bold">Resurse</h6>
                <h2 class="display-4">Ultimele Articole</h2>
            </div>
            <a asp-action="Articles" class="btn btn-outline-success px-5 mt-4 mt-md-0">Vezi Toate</a>
        </div>
        
        <div class="row g-4">
            @if (latestArticles != null)
            {
                @foreach (var article in latestArticles)
                {
                    <div class="col-lg-4">
                        <div class="card h-100 border-0 overflow-hidden" style="border-radius: 30px;">
                            @if (!string.IsNullOrEmpty(article.ImageUrl))
                            {
                                <img src="@article.ImageUrl" class="card-img-top" alt="@article.Title" style="height: 250px; object-fit: cover;">
                            }
                            <div class="card-body p-4">
                                <h4 class="mb-3 text-serif">@article.Title</h4>
                                <p class="text-muted small mb-4">@(article.Content.Length > 120 ? article.Content.Substring(0, 120) + "..." : article.Content)</p>
                                <a asp-action="ArticleDetails" asp-route-id="@article.Id" class="btn btn-link p-0 text-success fw-bold text-decoration-none text-uppercase ls-1 small">Citește mai mult <i class="fas fa-arrow-right ms-2"></i></a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<style>
    .shadow-2xl {
        box-shadow: 0 25px 50px -12px rgba(45, 80, 22, 0.15);
    }
</style>
