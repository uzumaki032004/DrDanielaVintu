@{
    ViewData["Title"] = "Dashboard Laboratoare";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 fw-bold text-primary">Dr. Daniela Vîntu</h1>
        <p class="lead text-secondary">Portal Management Laboratoare - Design Patterns & SOLID</p>
    </div>

    <div class="row g-4">
        <!-- Laborator 1 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body text-center">
                    <div class="display-6 mb-3 text-primary"><i class="bi bi-box-seam"></i></div>
                    <h5 class="card-title">Laborator 1</h5>
                    <p class="card-text small text-muted">Recapitulare OOP și Principiile SOLID în context medical.</p>
                    <a asp-controller="Lab1" asp-action="Index" class="btn btn-primary w-100">Deschide</a>
                </div>
            </div>
        </div>

        <!-- Laborator 2 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body text-center">
                    <div class="display-6 mb-3 text-success"><i class="bi bi-factory"></i></div>
                    <h5 class="card-title">Laborator 2</h5>
                    <p class="card-text small text-muted">Factory Method și Abstract Factory (Servicii & UI).</p>
                    <a asp-controller="Lab2" asp-action="Index" class="btn btn-success w-100">Deschide</a>
                </div>
            </div>
        </div>

        <!-- Laborator 3 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body text-center">
                    <div class="display-6 mb-3 text-info"><i class="bi bi-tools"></i></div>
                    <h5 class="card-title">Laborator 3</h5>
                    <p class="card-text small text-muted">Builder, Prototype și Singleton (Planuri & Setări).</p>
                    <a asp-controller="Lab3" asp-action="Index" class="btn btn-info w-100 text-white">Deschide</a>
                </div>
            </div>
        </div>

        <!-- Laborator 4 -->
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 transition-hover">
                <div class="card-body text-center">
                    <div class="display-6 mb-3 text-warning"><i class="bi bi-diagram-3"></i></div>
                    <h5 class="card-title">Laborator 4</h5>
                    <p class="card-text small text-muted">Adapter, Composite și Façade (Rapoarte & Onboarding).</p>
                    <a asp-controller="Lab4" asp-action="Index" class="btn btn-warning w-100 text-white">Deschide</a>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-5 p-4 bg-light rounded-3 shadow-sm">
        <h5><i class="bi bi-info-circle me-2"></i>Status Proiect</h5>
        <p class="mb-0">Toate cele 4 laboratoare sunt complet implementate la nivel de cod și interfață. Proiectul este structurat modular, respectând bunele practici de arhitectură software.</p>
    </div>
</div>

<style>
    .transition-hover:hover {
        transform: translateY(-5px);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }
</style>
