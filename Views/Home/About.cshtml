@model Dictionary<string, string>
@{
    ViewData["Title"] = "Despre mine";
    var name = Model.GetValueOrDefault("About_Name", "Dr. Daniela Vîntu");
    var title = Model.GetValueOrDefault("About_Title", "Nutriționist-Dietetician");
    var bio = Model.GetValueOrDefault("About_Bio", "Expert în nutriție...");
    var photo = Model.GetValueOrDefault("About_PhotoUrl", "");
}

<div class="container py-5">
    <div class="row align-items-center g-5">
        <div class="col-lg-5 text-center">
            @if (!string.IsNullOrEmpty(photo))
            {
                <div class="position-relative d-inline-block">
                    <img src="@photo" class="img-fluid rounded-4 shadow-lg border border-5 border-white" alt="@name" style="max-height: 500px; width: 100%; object-fit: cover;">
                    <div class="position-absolute bottom-0 end-0 bg-success p-3 rounded-circle shadow-sm m-3">
                        <i class="fas fa-stethoscope text-white fs-4"></i>
                    </div>
                </div>
            }
            else
            {
                <div class="bg-white p-5 rounded-4 shadow-sm border border-dashed text-center">
                    <i class="fas fa-user-md fa-10x text-light mb-3"></i>
                    <p class="text-muted">Fotografia va fi afișată aici după încărcare.</p>
                </div>
            }
        </div>
        <div class="col-lg-7">
            <h6 class="text-success text-uppercase fw-bold ls-1 mb-2">Despre mine</h6>
            <h1 class="display-4 fw-bold mb-3" style="color: var(--royal-green);">@name</h1>
            <h4 class="text-muted fw-light mb-4">@title</h4>
            
            <div class="bio-content lead text-secondary mb-5" style="white-space: pre-line; line-height: 1.8;">
                @bio
            </div>

            <div class="row g-4">
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 shadow-sm">
                        <div class="bg-light p-2 rounded-circle"><i class="fas fa-graduation-cap text-success"></i></div>
                        <div>
                            <div class="fw-bold">Studii</div>
                            <div class="small text-muted">Specialist Nutriție</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="d-flex align-items-center gap-3 p-3 bg-white rounded-3 shadow-sm">
                        <div class="bg-light p-2 rounded-circle"><i class="fas fa-certificate text-success"></i></div>
                        <div>
                            <div class="fw-bold">Certificări</div>
                            <div class="small text-muted">Expert Acreditat</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 2px; }
    .border-dashed { border: 2px dashed #dee2e6; }
</style>
