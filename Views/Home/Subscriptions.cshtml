@model List<DrDanielaVintu.Models.SubscriptionPlan>
@{
    ViewData["Title"] = "Programe și Consultații";
}

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h6 class="text-success text-uppercase fw-bold ls-1 mb-2">Investiție în Sănătate</h6>
        <h1 class="display-4 fw-bold mb-3" style="color: var(--royal-green);">Programe și Consultații</h1>
        <p class="lead text-secondary mx-auto" style="max-width: 600px;">
            Alege formatul potrivit pentru nevoile tale și pornește astăzi pe drumul către o viață echilibrată.
        </p>
    </div>

    <div class="row g-4 justify-content-center align-items-stretch">
    <div class="row g-4 mt-4 program-row justify-content-center">
        @foreach (var plan in Model)
        {
            <div class="col-lg-4 col-md-6 program-col">
                <div class="card h-100 p-5 text-center border-0 shadow-lg @(plan.IsPopular ? "popular-card" : "")" style="border-radius: 40px;">
                    @if (plan.IsPopular)
                    {
                        <span class="badge bg-success rounded-pill px-3 py-2 text-uppercase mb-4 align-self-center small ls-1">Cel mai ales</span>
                    }
                    <h3 class="mb-3">@plan.Name</h3>
                    <div class="mb-4">
                        <span class="h1 fw-bold text-success">@plan.Price.ToString("F0")</span>
                        <span class="text-muted">EUR</span>
                    </div>
                    <ul class="list-unstyled mb-5 text-start opacity-75">
                        @foreach (var b in plan.Benefits.Split(new[] { ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <li class="mb-3 d-flex align-items-start gap-2">
                                <i class="fas fa-check text-success mt-1 small"></i>
                                <span>@b.Trim()</span>
                            </li>
                        }
                    </ul>
                    <button class="btn btn-success w-100 mt-auto py-3">Rezervă Acest Plan</button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 2px; }
    .pricing-card:hover {
        transform: translateY(-15px);
    }
    .popular-card {
        border: 2px solid var(--accent-green) !important;
        background-color: #fff;
    }
    .price-box {
        color: var(--royal-green);
    }
    .pricing-card .card-body {
        background: linear-gradient(180deg, #ffffff 0%, #fdfdfd 100%);
    }
</style>
