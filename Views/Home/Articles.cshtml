@model List<DrDanielaVintu.Models.Article>
@{
    ViewData["Title"] = "Articole și Resurse";
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var categories = ViewBag.Categories as List<string>;
    var selectedCat = ViewBag.SelectedCategory as string;
    var searchQuery = ViewBag.SearchQuery as string;
}

<div class="container py-5 mt-5">
    <div class="text-center mb-5">
        <h6 class="text-success text-uppercase fw-bold ls-1 mb-2">Educație și Nutriție</h6>
        <h1 class="display-4 fw-bold mb-3" style="color: var(--royal-green);">Articole și Sfaturi</h1>
        
        <!-- Search Bar -->
        <div class="row justify-content-center mt-4">
            <div class="col-md-6">
                <form asp-action="Articles" method="get" class="d-flex gap-2">
                    <input type="text" name="q" value="@searchQuery" class="form-control rounded-pill px-4 shadow-sm" placeholder="Caută un subiect..." />
                    <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm"><i class="fas fa-search"></i></button>
                </form>
            </div>
        </div>

        <!-- Categories -->
        @if (categories != null && categories.Any())
        {
            <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                <a asp-action="Articles" class="badge rounded-pill px-3 py-2 text-decoration-none @(string.IsNullOrEmpty(selectedCat) ? "bg-success text-white" : "bg-light text-success border border-success")">Toate</a>
                @foreach (var cat in categories)
                {
                    <a asp-action="Articles" asp-route-category="@cat" class="badge rounded-pill px-3 py-2 text-decoration-none @(selectedCat == cat ? "bg-success text-white" : "bg-light text-success border border-success")">@cat</a>
                }
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-search fa-3x text-muted mb-3 opacity-25"></i>
            <h4 class="text-muted">Nu am găsit niciun articol pentru această căutare.</h4>
            <a asp-action="Articles" class="btn btn-link text-success">Vezi toate articolele</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var article in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <article class="card h-100 border-0 shadow-sm overflow-hidden article-card" style="border-radius: 20px; transition: all 0.3s ease;">
                        @if (!string.IsNullOrEmpty(article.ImageUrl))
                        {
                            <div class="article-img-container">
                                <img src="@article.ImageUrl" class="card-img-top" alt="@article.Title" style="height: 250px; object-fit: cover;">
                            </div>
                        }
                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-light text-success rounded-pill px-3">@article.CreatedAt.ToString("dd.MM.yyyy")</span>
                                <small class="text-muted">@article.Category</small>
                            </div>
                            <h4 class="card-title fw-bold mb-3" style="color: var(--royal-green);">@article.Title</h4>
                            <p class="card-text text-secondary mb-4 flex-grow-1">
                                @(article.Content.Length > 120 ? article.Content.Substring(0, 120) + "..." : article.Content)
                            </p>
                            <a asp-action="ArticleDetails" asp-route-id="@article.Id" class="btn btn-outline-success rounded-pill fw-bold">
                                Citește mai mult
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="mt-5">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3 me-2" asp-action="Articles" asp-route-page="@(currentPage - 1)" asp-route-q="@searchQuery" asp-route-category="@selectedCat"><i class="fas fa-chevron-left"></i></a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(currentPage == i ? "active" : "")">
                            <a class="page-link rounded-pill px-3 me-2 @(currentPage == i ? "bg-success border-success" : "text-success")" asp-action="Articles" asp-route-page="@i" asp-route-q="@searchQuery" asp-route-category="@selectedCat">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Articles" asp-route-page="@(currentPage + 1)" asp-route-q="@searchQuery" asp-route-category="@selectedCat"><i class="fas fa-chevron-right"></i></a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

<style>
    .article-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    .page-link { border: none; }
</style>
