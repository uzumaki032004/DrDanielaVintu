@model List<DrDanielaVintu.Models.Article>
@{
    ViewData["Title"] = "Articole și Resurse";
}

<div class="container py-5 mt-4">
    <div class="text-center mb-5">
        <h6 class="text-success text-uppercase fw-bold ls-1 mb-2">Educație și Nutriție</h6>
        <h1 class="display-4 fw-bold mb-3" style="color: var(--royal-green);">Articole și Sfaturi</h1>
        <p class="lead text-secondary mx-auto" style="max-width: 600px;">
            Descoperă noutăți, rețete și ghiduri pentru o sănătate de fier.
        </p>
    </div>

    <div class="row g-4">
        @foreach (var article in Model)
        {
            <div class="col-md-6 col-lg-4">
                <article class="card h-100 border-0 shadow-sm overflow-hidden article-card" style="border-radius: 20px; transition: all 0.3s ease;">
                    @if (!string.IsNullOrEmpty(article.ImageUrl))
                    {
                        <div class="article-img-container">
                            <img src="@article.ImageUrl" class="card-img-top" alt="@article.Title">
                        </div>
                    }
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-light text-success rounded-pill px-3">@article.CreatedAt.ToString("dd.MM.yyyy")</span>
                            <small class="text-muted"><i class="fas fa-user me-1"></i> @article.Author</small>
                        </div>
                        <h4 class="card-title fw-bold mb-3" style="color: var(--royal-green);">@article.Title</h4>
                        <p class="card-text text-secondary mb-4 flex-grow-1">
                            @(article.Content.Length > 150 ? article.Content.Substring(0, 150) + "..." : article.Content)
                        </p>
                        <a asp-action="ArticleDetails" asp-route-id="@article.Id" class="btn btn-outline-success rounded-pill fw-bold">
                            Citește mai mult
                        </a>
                    </div>
                </article>
            </div>
        }
    </div>
</div>

<style>
    .ls-1 { letter-spacing: 2px; }
    .article-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
    }
    .article-img-container {
        height: 250px;
        overflow: hidden;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .article-img-container img {
        width: 100%;
        height: 100%;
        object-fit: contain; /* Aceasta asigură că poza se vede în totalitate */
        transition: transform 0.5s ease;
    }
    .article-card:hover .article-img-container img {
        transform: scale(1.05);
    }
</style>
